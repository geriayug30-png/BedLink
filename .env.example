PORT=3000
HOST=127.0.0.1
SUPABASE_URL=http://127.0.0.1:54321
# Local Supabase publishable key or legacy anon key; never a service-role key.
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JSON_LIMIT_BYTES=16384
UPSTREAM_TIMEOUT_MS=10000
# Prototype matching policy. Custom numeric settings require a new policy version.
MATCH_POLICY_VERSION=demo-1
MATCH_TRAVEL_WEIGHT=0.5
MATCH_FRESHNESS_WEIGHT=0.3
MATCH_HEADROOM_WEIGHT=0.2
MATCH_TRAVEL_HORIZON_MINUTES=60
MATCH_SIMULATED_SPEED_KPH=30
MATCH_SIMULATED_ROAD_FACTOR=1.3
MATCH_TRAVEL_TIMEOUT_MS=5000
# Backend-only connections. Use separate restricted LOGIN users granted the named
# NOLOGIN roles from migration 005, not postgres or a service-role key. Never expose in a frontend.
# PostgreSQL direct or SESSION pooler connection (transaction state is required).
WORKFLOW_DATABASE_URL=postgresql://bedlink_api_login:replace-local-password@127.0.0.1:54322/postgres
WORKER_DATABASE_URL=postgresql://bedlink_worker_login:replace-local-password@127.0.0.1:54322/postgres
WORKER_POLL_MS=2000
WORKER_BATCH_SIZE=100
